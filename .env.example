# SPHEREx Sky Viewer Environment Configuration
# Copy this file to .env for local overrides (never commit .env to GitHub)

# Force offline demo mode using bundled samples (0 = Live IRSA, 1 = Offline only)
SPHEREX_OFFLINE=0

# Server host and port configuration (default: 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000
